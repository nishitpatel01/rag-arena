# The RAG Arena (v3.0) - Runtime & Model Configuration
# Copy this file to .env (git-ignored) and fill in YOUR values. Never commit real project ids,
# bucket names, account emails, credential paths, or gcloud profile directories.

# Execution mode: replay (zero-credential, plays data/recordings/**) | record (live + writes recordings) | live
DEMO_MODE=replay
REPLAY_SPEED=1.0
# Set to 1 only for local UI development against the synthetic data/recordings/_dev fixture.
ALLOW_DEV_FIXTURES=0

# Levels enabled in the registry / UI (comma-separated, in ladder order). A level is enabled only after its
# Definition of Done (spec.md §9) is signed off.
ENABLED_LEVELS=level1_naive,level2_hybrid,level3_multimodal

# Google Cloud project & storage (required when DEMO_MODE=live|record)
GCP_PROJECT_ID=your-gcp-project-id
GCP_LOCATION=us-central1
VERTEX_GENAI_LOCATION=global
GCS_CORPUS_BUCKET=your-gcp-project-id-rag-arena-corpus
BQ_DATASET=rag_arena
BQ_TABLE=document_chunks_v3

# Optional isolated gcloud profile + Application Default Credentials (leave empty to use the gcloud defaults)
CLOUDSDK_CONFIG=
GOOGLE_APPLICATION_CREDENTIALS=

# Gemini model identifiers & thinking level
GEMINI_FAST_MODEL=gemini-4-argon
GEMINI_PRO_MODEL=gemini-4-argon
GEMINI_REASONING_MODEL=gemini-4-argon
GEMINI_THINKING_LEVEL=high

# LLM-as-a-judge (must differ from GEMINI_FAST_MODEL / GEMINI_PRO_MODEL — a model never grades its own answers).
# anthropic_vertex = Claude on Vertex AI via :rawPredict (ADC bearer); Claude Opus 5.5 is served on the "global" endpoint.
# gemini = a structured-output Gemini judge (JUDGE_MODEL must then be a different gemini-* model).
JUDGE_PROVIDER=anthropic_vertex
JUDGE_MODEL=claude-opus-5-5
JUDGE_LOCATION=global
JUDGE_MAX_TOKENS=1024
JUDGE_TIMEOUT_SECONDS=60

# Embedding & reranking models
TEXT_EMBEDDING_MODEL=gemini-embedding-2
MULTIMODAL_EMBEDDING_MODEL=gemini-embedding-2
RERANKER_MODEL=semantic-ranker-default@latest

# Level 3 (Layout-Aware Multimodal): Document AI Layout Parser + Gemini vision transcription of diagram pages.
# DOCAI_PROCESSOR_ID = short id printed by scripts/provision_documentai.py (never the full resource name).
DOCAI_LOCATION=us
DOCAI_PROCESSOR_ID=
# Optional processor version (empty = processor default). The Gemini layout parser (release candidate) returns table
# structure but no bounding boxes; element boxes are then located on the PDF text layer (bbox_source=pdf_text_layer).
DOCAI_PROCESSOR_VERSION=pretrained-layout-parser-v1.5-2025-08-25
DOCAI_TIMEOUT_SECONDS=120
VISION_MODEL=gemini-4-argon

# Execution & guardrail bounds
QUERY_TIMEOUT_SECONDS=90
INGEST_JOB_TIMEOUT_SECONDS=1800
MAX_UPLOAD_BYTES=10485760
MAX_UPLOAD_PAGES=30

# Public mirror scrub: identity tokens replaced by scripts/publish_mirror_scrub.py ("old=new,old2=new2").
# Keep usernames / internal hostnames here, not in publish.json.
PUBLISH_SCRUB_TOKENS=

# Optional extra CORS origins regex for cross-origin frontends (the Vite dev proxy and Cloud Run same-origin need none)
CORS_ALLOW_ORIGIN_REGEX=
