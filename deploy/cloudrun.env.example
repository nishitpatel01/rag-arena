# The RAG Arena — Cloud Run deployment config (read by scripts/deploy_cloudrun.sh and scripts/teardown_cloudrun.sh).
# Copy to deploy/cloudrun.env (git-ignored) and fill in YOUR values. Never commit the copy: it holds your project id,
# bucket and allowlisted accounts. Preview with `scripts/deploy_cloudrun.sh --dry-run`, apply with `--yes`.

# ---------------------------------------------------------------- Where to deploy
# Your Google Cloud project (must already have the RAG Arena data: see docs/SETUP_GUIDE.md).
GCP_PROJECT_ID=your-gcp-project-id
# Cloud Run + Artifact Registry + Cloud Build region.
REGION=us-central1
# Live service name and the Artifact Registry docker repo the image is pushed to.
SERVICE_NAME=rag-arena
ARTIFACT_REPO=rag-arena
# Optional fixed image tag (default: <git sha>-<UTC timestamp>).
IMAGE_TAG=

# ---------------------------------------------------------------- Who can use the live app
# iap    = Identity-Aware Proxy in front of the live service; only IAP_MEMBERS can sign in (recommended).
# public = anyone with the URL can start LIVE runs billed to your project (cost exposure; not recommended).
ACCESS_MODE=iap
# Comma-separated principals allowed through IAP (required when ACCESS_MODE=iap):
#   user:EMAIL, group:EMAIL, serviceAccount:EMAIL, domain:DOMAIN   (allUsers / allAuthenticatedUsers are rejected)
IAP_MEMBERS=user:you@example.com

# ---------------------------------------------------------------- Optional public replay-only copy
# true = also deploy REPLAY_SERVICE_NAME: same image, DEMO_MODE=replay (plays data/recordings, zero cloud calls),
# public, running as a service account with NO roles; its /api/v1/health never shows your project or bucket.
DEPLOY_REPLAY=true
REPLAY_SERVICE_NAME=rag-arena-replay

# ---------------------------------------------------------------- Identities
# Live runtime service account (least privilege, no key files) and the role-less replay service account.
RUNTIME_SA_NAME=rag-arena-run
REPLAY_SA_NAME=rag-arena-replay
# true  = the live service may run ingestion jobs: roles/discoveryengine.editor (documents:import) +
#         roles/storage.objectUser on the corpus bucket.
# false = query-only: roles/discoveryengine.viewer + roles/storage.objectViewer (run ingestion locally instead).
LIVE_INGEST=true

# ---------------------------------------------------------------- Sizing & bounds (min-instances 0 = $0 when idle)
MIN_INSTANCES=0
MAX_INSTANCES=2
REPLAY_MAX_INSTANCES=3
CPU=1
MEMORY=2Gi
REPLAY_MEMORY=1Gi
CONCURRENCY=20
REPLAY_CONCURRENCY=40
# Request timeout in seconds (300-3600). Live runs stream for ~60-120 s (Level 4 longer); an ingestion job's stream
# must finish within TIMEOUT, so keep INGEST_JOB_TIMEOUT_SECONDS below it. Longer ingestion: run it locally.
TIMEOUT=900
REPLAY_TIMEOUT=300

# Optional extra comma-separated strings the pre-build leak scan must not find in the uploaded source
# (project id, project number, bucket and your gcloud account are always checked).
LEAK_SCAN_TOKENS=

# ---------------------------------------------------------------- App settings forwarded to the LIVE service
# Same names and meaning as .env (see .env.example). DEMO_MODE must be live here.
DEMO_MODE=live
ENABLED_LEVELS=level1_naive,level2_hybrid,level3_multimodal,level4_agentic,managed_vertex
GCP_LOCATION=us-central1
VERTEX_GENAI_LOCATION=global
GCS_CORPUS_BUCKET=your-gcp-project-id-rag-arena-corpus
# v1.1 private bucket for your own documents. Empty = <GCP_PROJECT_ID>-rag-arena-uploads.
# auto = the app/scripts try to create it (public access prevention enforced, uniform access, no auto-delete);
#        if the identity lacks storage.buckets.create or an org policy blocks it, a clear error is shown.
# existing = never create; UPLOAD_BUCKET must already exist and be private.
UPLOAD_BUCKET=
UPLOAD_BUCKET_MODE=auto
# Optional CMEK for a bucket the app creates: projects/P/locations/L/keyRings/R/cryptoKeys/K
UPLOAD_BUCKET_KMS_KEY=
BQ_DATASET=rag_arena
BQ_TABLE=document_chunks_v3
GEMINI_FAST_MODEL=gemini-4-argon
GEMINI_PRO_MODEL=gemini-4-argon
GEMINI_THINKING_LEVEL=high
JUDGE_PROVIDER=anthropic_vertex
JUDGE_MODEL=claude-opus-5-5
JUDGE_LOCATION=global
TEXT_EMBEDDING_MODEL=gemini-embedding-2
MULTIMODAL_EMBEDDING_MODEL=gemini-embedding-2
RERANKER_MODEL=semantic-ranker-default@latest
DOCAI_LOCATION=us
DOCAI_PROCESSOR_ID=
DOCAI_PROCESSOR_VERSION=pretrained-layout-parser-v1.5-2025-08-25
VISION_MODEL=gemini-4-argon
VAIS_LOCATION=global
VAIS_DATA_STORE_ID=rag-arena-procurement
VAIS_ENGINE_ID=rag-arena-procurement-search
VAIS_UPLOADS_DATA_STORE_ID=rag-arena-uploads
VAIS_UPLOADS_ENGINE_ID=rag-arena-uploads-search
QUERY_TIMEOUT_SECONDS=120
INGEST_JOB_TIMEOUT_SECONDS=840

# Local-only keys (e.g. CLOUDSDK_CONFIG=<dir> to make the script use an isolated gcloud profile; also
# GOOGLE_APPLICATION_CREDENTIALS) may be added here or exported in your shell, but are NEVER forwarded to Cloud Run,
# which authenticates as RUNTIME_SA_NAME via the metadata server (no key files).
